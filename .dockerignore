# Applies to every build whose context is implementation/ (the api image
# and the all-in-one Dockerfile both build from here) - excludes only what
# no build ever needs: build artifacts, caches, and anything sensitive.
# Do not exclude jenkins/ or dashboard/frontend/ here - the all-in-one
# Dockerfile needs both from this same context, even though the narrower
# api image does not.

.git/
.env
.env.local

**/node_modules/
**/dist/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

demo-app/
findings/**/*.json
!findings/.gitkeep
!findings/scan-inputs/.gitkeep

docs/
validation/scenarios/
