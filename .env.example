# Copy to .env and adjust for your machine.
#
# HOST_WORKSPACE must be the ABSOLUTE PATH OF THIS DIRECTORY ON THE HOST.
#
# The pipeline runs scanners as sibling containers through the mounted Docker
# socket. Volume paths in those `docker run` commands are resolved by the host
# daemon, not inside the Jenkins container, so they cannot use the container's
# /workspace path - they need the real host path.
#
#   Linux / macOS : HOST_WORKSPACE=/home/you/threatweave/implementation
#   Windows       : HOST_WORKSPACE=D:/repos/threatweave/implementation
#                   (forward slashes, no trailing slash)
HOST_WORKSPACE=/absolute/path/to/threatweave/implementation

# TARGET_PATH is the ABSOLUTE HOST PATH OF THE PROJECT YOU WANT TO SCAN.
#
# It is mounted into Jenkins at /target, so a pipeline run can reach a project
# that lives anywhere on the host rather than only inside this directory. Set
# the SOURCE_DIR build parameter to a path under /target to scan it.
#
#   TARGET_PATH=/home/you/my-app        ->  SOURCE_DIR=/target
#   TARGET_PATH=/home/you/repos         ->  SOURCE_DIR=/target/my-app
#
# Leave it at the default to scan the bundled OWASP Juice Shop demo target.
TARGET_PATH=./demo-app

# Host port for the API. Change it if something else on your machine already
# listens on 4000 - Docker fails to start the container rather than sharing the
# port. The dashboard is unaffected either way: it reaches the API as
# api:4000 inside the compose network, not through this published port.
API_PORT=4000

# Jenkins admin account created on first boot.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# Optional: enable the SAST stage by pointing at a SonarQube server.
#
# Start one with:  docker compose --profile sast up -d
# Then generate a token in the SonarQube UI (http://localhost:9000):
#   My Account -> Security -> Generate Token (type: Global Analysis Token)
#
# The service name resolves because both Jenkins and the sonar-scanner
# sibling container are attached to the compose network - do not use
# localhost here, it would refer to the container itself.
# SONAR_HOST_URL=http://sonarqube:9000
# SONAR_TOKEN=

# Optional: keep a real GitHub-hosted target in sync with pushes, so the
# pipeline's existing polling (see the Jenkinsfile) picks up new commits
# within a few minutes instead of waiting for someone to click "Run scan".
#
# Needs a host GitHub can actually reach over the internet (e.g. an EC2
# instance) - it cannot reach a machine on your local network or behind NAT.
# TARGET_PATH above must point at a real `git clone` of that repo, not the
# bundled demo target.
#
# Start it with:  docker compose --profile webhook up -d
# Then, in the GitHub repo: Settings -> Webhooks -> Add webhook
#   Payload URL : http://<your-public-host>:9000/webhook
#   Content type: application/json
#   Secret      : the same value as WEBHOOK_SECRET below
#   Events      : just the push event
#
# Generate a real secret rather than leaving this as a placeholder -
# anyone who can guess it could otherwise trigger a git pull on the box:
#   openssl rand -hex 32
# WEBHOOK_SECRET=
# WEBHOOK_BRANCH=refs/heads/main
# WEBHOOK_PORT=9000
