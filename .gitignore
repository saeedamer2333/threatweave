# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
build/
.env
.env.local

# Findings output (generated at runtime, keep folders via .gitkeep).
# ** so this also covers findings/scan-inputs/*.json - a real run's raw
# scanner reports can contain a real AWS account ID and resource names.
findings/**/*.json
!findings/.gitkeep
!findings/scan-inputs/.gitkeep

# GitLeaks incremental-scan state (last-scanned commit + cumulative
# findings) - runtime-generated per environment, not something to commit.
findings/gitleaks-state/

# The Checkout stage's "skip an auto-triggered run if nothing changed"
# marker (the demo target's last-scanned commit hash) - runtime state tied
# to whatever target this specific environment happens to be scanning,
# not something a fresh clone should start with a stale value for.
findings/.last-scanned-commit

# Vendored demo scan target (OWASP Juice Shop, ~95MB) - fetched on demand by
# scripts/fetch-demo-target.sh rather than committed, so the repo stays small
# and focused on ThreatWeave's own code.
/demo-app/

# AWS credentials — NEVER commit
.aws/
*.pem

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model artifacts
*.pkl
*.joblib
# ...except the trained Random Forest, which must ship with the project.
# Nothing in the install path retrains it, and P_RF is 45% of the risk score,
# so a clone without this file silently falls back to a CVSS heuristic.
!aiops_engine/ml/model/rf_model.joblib
